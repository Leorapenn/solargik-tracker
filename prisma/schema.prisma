generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhaseName {
  INITIATION
  DESIGN
  SUPPLY
  CONSTRUCTION
  COMMISSIONING
  OM
}

enum Department {
  FINANCE
  DESIGN
  SUPPLY
  LOGISTICS
  CONSTRUCTION
  COMMISSIONING
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum CustomerImportance {
  NORMAL
  SEMI_STRATEGIC
  STRATEGIC
}

model Customer {
  id           String             @id @default(cuid())
  name         String             @unique
  importance   CustomerImportance @default(NORMAL)
  mondayItemId String?            @unique
  // Fields edited by hand on the site; the importer leaves these alone until they are reset.
  lockedFields String[]           @default([])
  // Labels added by hand on the site (e.g. "Payment risk"); never touched by the importer.
  flags        String[]           @default([])
  // Green / yellow / red per flag label: {"Payment risk": "RED"}. A flag with no entry counts as yellow.
  flagColors   Json               @default("{}")
  aliases      CustomerAlias[]
  projects     Project[]
  contacts     Contact[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum ContactSource {
  IMPORTED
  MANUAL
}

// A person at the customer. Imported from the POC 1-4 columns on the monday Supply Projects
// board (one row per project and slot), or added by hand on the customer profile.
model Contact {
  id           String        @id @default(cuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slot         Int?
  name         String
  email        String?
  role         String?
  englishLevel String?
  source       ContactSource @default(IMPORTED)
  // Set when edited by hand, so the importer no longer overwrites or removes it.
  locked       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, slot])
  @@index([customerId])
}

model CustomerAlias {
  id         String   @id @default(cuid())
  alias      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
}

enum ProjectLifecycle {
  ACTIVE
  PRE_NTP
  ON_HOLD
  SUSPENDED
  CANCELLED
}

model Project {
  id            String           @id @default(cuid())
  name          String
  mondayItemId  String           @unique
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  contractValue Decimal?
  capacityMw    Decimal?
  country       String?
  // Derived from the Control Table STAGE/Status columns on import (see src/lib/lifecycle.ts);
  // the raw monday labels are kept so the mapping can be re-checked.
  lifecycle     ProjectLifecycle @default(ACTIVE)
  mondayStage   String?
  mondayStatus  String?
  // Fields edited by hand on the site; the importer leaves these alone until they are reset.
  lockedFields  String[]         @default([])
  // Labels added by hand on the site (e.g. "Payment risk"); never touched by the importer.
  flags         String[]         @default([])
  phases        Phase[]
  contacts      Contact[]
  profile       ProjectProfile?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// The "project profile": extra details people fill in by hand (or from the contract), one row per project,
// created the first time it is saved. Dropdown fields store a code (see src/lib/projectProfile.ts); null is
// the blank default. Dates that already exist as sub-stages (kickoffs, layout approval, BOM release...) are
// NOT stored here: the page shows those items' own dates and statuses.
model ProjectProfile {
  projectId String  @id
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Project details
  pileDrivingStart     DateTime?
  deliveryExpectations String?
  supplyTerms          String?
  supplyObligations    String?
  soilTest             String? // SPT / GPT
  intercoms            String?
  soma                 String?
  // Only a fallback for the Contract Signing item's own completed date (e.g. read from the contract).
  contractSigningDate  DateTime?
  ntpDate              DateTime?
  projectType          String?
  contractLink         String? // link to the contract file (e.g. SharePoint)

  // Design details
  projectEngineerId           String?
  projectEngineer             Person?   @relation(fields: [projectEngineerId], references: [id], onDelete: SetNull)
  designNotes                 String?
  designQuestionnaireReceived DateTime?
  designInfoStatus            String?
  geotechStatus               String?
  initialLayoutSent           DateTime?
  genioCivileStatus           String?
  bomStatus                   String?

  updatedAt DateTime @updatedAt
}

model Phase {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      PhaseName
  status    StageStatus @default(NOT_STARTED)
  order     Int
  subStages SubStage[]

  @@unique([projectId, name])
}

model SubStageTemplate {
  id         String     @id @default(cuid())
  phase      PhaseName
  department Department
  name       String
  order      Int
  active     Boolean    @default(true)
  // Date fields that never apply to this item (e.g. "targetDate" for Contract Signing); copied to new items.
  naDates    String[]   @default([])
  subStages  SubStage[]

  @@unique([phase, name])
}

model SubStage {
  id          String           @id @default(cuid())
  phaseId     String
  phase       Phase            @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  templateId  String
  template    SubStageTemplate @relation(fields: [templateId], references: [id])
  name        String
  department  Department
  status      StageStatus      @default(NOT_STARTED)
  order       Int
  ownerId     String?
  owner       Person?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Plain dates (no time). Start/completed are recorded automatically when the status changes.
  targetDate  DateTime?        @db.Date
  startedAt   DateTime?        @db.Date
  completedAt DateTime?        @db.Date
  // Dates deliberately marked "N/A" ("targetDate" | "startedAt" | "completedAt"): not applicable to this item,
  // as opposed to simply not set yet. An N/A date stays empty and never raises a missing-date warning.
  naDates     String[]         @default([])
  events      StatusEvent[]
}

// Every status change, with its timestamp, so dates can always be reconstructed.
model StatusEvent {
  id         String       @id @default(cuid())
  subStageId String
  subStage   SubStage     @relation(fields: [subStageId], references: [id], onDelete: Cascade)
  fromStatus StageStatus?
  toStatus   StageStatus
  at         DateTime     @default(now())
  source     String

  @@index([subStageId, at])
}

model Person {
  id                 String            @id @default(cuid())
  name               String            @unique
  email              String?
  active             Boolean           @default(true)
  subStages          SubStage[]
  defaultFor         DepartmentOwner[]
  engineeredProfiles ProjectProfile[]
  createdAt          DateTime          @default(now())
}

// The person who owns new items of a department by default (used when projects are created).
model DepartmentOwner {
  department Department @id
  personId   String
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model ImportReviewItem {
  id             String   @id @default(cuid())
  boardId        String
  mondayItemId   String
  itemName       String
  rawCustomerRef String
  reason         String
  createdAt      DateTime @default(now())

  @@unique([boardId, mondayItemId])
}
