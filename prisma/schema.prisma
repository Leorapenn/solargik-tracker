generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhaseName {
  INITIATION
  DESIGN
  SUPPLY
  CONSTRUCTION
  COMMISSIONING
  OM
}

enum Department {
  FINANCE
  DESIGN
  SUPPLY
  LOGISTICS
  CONSTRUCTION
  COMMISSIONING
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum CustomerImportance {
  NORMAL
  SEMI_STRATEGIC
  STRATEGIC
}

model Customer {
  id           String             @id @default(cuid())
  name         String             @unique
  importance   CustomerImportance @default(NORMAL)
  mondayItemId String?            @unique
  // Fields edited by hand on the site; the importer leaves these alone until they are reset.
  lockedFields String[]           @default([])
  // Labels added by hand on the site (e.g. "Payment risk"); never touched by the importer.
  flags        String[]           @default([])
  // Green / yellow / red per flag label: {"Payment risk": "RED"}. A flag with no entry counts as yellow.
  flagColors   Json               @default("{}")
  aliases      CustomerAlias[]
  projects     Project[]
  contacts     Contact[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum ContactSource {
  IMPORTED
  MANUAL
}

// A person at the customer. Imported from the POC 1-4 columns on the monday Supply Projects
// board (one row per project and slot), or added by hand on the customer profile.
model Contact {
  id           String        @id @default(cuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slot         Int?
  name         String
  email        String?
  phone        String?
  role         String?
  englishLevel String?
  source       ContactSource @default(IMPORTED)
  // Set when edited by hand, so the importer no longer overwrites or removes it.
  locked       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, slot])
  @@index([customerId])
}

model CustomerAlias {
  id         String   @id @default(cuid())
  alias      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
}

enum ProjectLifecycle {
  ACTIVE
  PRE_NTP
  ON_HOLD
  SUSPENDED
  CANCELLED
}

model Project {
  id              String           @id @default(cuid())
  name            String
  mondayItemId    String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  contractValue   Decimal?
  capacityMw      Decimal?
  // Exact size in kWp as written in the contract (e.g. 996.84). When set it is what the site shows; when
  // empty the site shows capacityMw (imported from monday.com, rounded to 1 kWp) x 1000. Never imported.
  capacityKwp     Decimal?         @db.Decimal(12, 2)
  country         String?
  // Derived from the Control Table STAGE/Status columns on import (see src/lib/lifecycle.ts);
  // the raw monday labels are kept so the mapping can be re-checked.
  lifecycle       ProjectLifecycle @default(ACTIVE)
  mondayStage     String?
  mondayStatus    String?
  // Fields edited by hand on the site; the importer leaves these alone until they are reset.
  lockedFields    String[]         @default([])
  // Labels added by hand on the site (e.g. "Payment risk"); never touched by the importer.
  flags           String[]         @default([])
  // Warranty periods in years when a project's contract differs from the Framework Agreement's 10 (structural
  // units) and 5 (drive unit). Empty = the default; see src/lib/warranty.ts.
  warrantyStructuralYears Int?
  warrantyDriveYears      Int?
  // Link to the project's folder in SharePoint (the EXECUTION library); a link only, nothing is copied.
  sharepointLink  String?
  // Severity of each project flag: {label: GREEN | YELLOW | RED}, like Customer.flagColors. Never imported.
  flagColors      Json             @default("{}")
  // The project manager on the customer's side (typed or copied from one of the customer's contacts).
  customerManagerName  String?
  customerManagerEmail String?
  customerManagerPhone String?
  // Typed-over project status summary. When empty the summary is generated from the phases' statuses
  // (src/lib/statusUpdate.ts) every time it is shown.
  statusSummaryOverride String?
  phases          Phase[]
  contacts        Contact[]
  profile         ProjectProfile?
  milestones      Milestone[]
  changeOrders    ChangeOrder[]
  suggestions     Suggestion[]
  // Payments (milestones, change orders) are in this currency (USD, EUR, ILS...). paymentBase is the
  // contract amount in that currency that milestone percentages apply to; when empty, contractValue
  // (imported from monday.com) is used.
  paymentCurrency String           @default("USD")
  paymentBase     Decimal?         @db.Decimal(14, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// The "project profile": extra details people fill in by hand (or from the contract), one row per project,
// created the first time it is saved. Dropdown fields store a code (see src/lib/projectProfile.ts); null is
// the blank default. Dates that already exist as sub-stages (kickoffs, layout approval, BOM release...) are
// NOT stored here: the page shows those items' own dates and statuses.
model ProjectProfile {
  projectId String  @id
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Project details
  pileDrivingStart     DateTime?
  deliveryExpectations String?
  supplyTerms          String?
  supplyObligations    String?
  soilTest             String? // SPT / GPT
  intercoms            String?
  soma                 String?
  // Only a fallback for the Contract Signing item's own completed date (e.g. read from the contract).
  contractSigningDate  DateTime?
  ntpDate              DateTime?
  projectType          String?
  contractLink         String? // link to the contract file (e.g. SharePoint)
  shippingAddress      String?
  deliveryAddress      String?

  // Design details
  projectEngineerId           String?
  projectEngineer             Person?   @relation(fields: [projectEngineerId], references: [id], onDelete: SetNull)
  designNotes                 String?
  designQuestionnaireReceived DateTime?
  designInfoStatus            String?
  geotechStatus               String?
  initialLayoutSent           DateTime?
  genioCivileStatus           String?
  bomStatus                   String?

  updatedAt DateTime @updatedAt
}

model Phase {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      PhaseName
  status    StageStatus @default(NOT_STARTED)
  order     Int
  subStages SubStage[]
  // Free-text status update typed by hand, and the calendar day it was last changed (set automatically).
  statusUpdate   String?
  statusUpdateAt DateTime? @db.Date
  // The person responsible for the phase as a whole (separate from the owners of its items).
  ownerId        String?
  owner          Person?   @relation("PhaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
}

model SubStageTemplate {
  id         String     @id @default(cuid())
  phase      PhaseName
  department Department
  name       String
  order      Int
  active     Boolean    @default(true)
  // Date fields that never apply to this item (e.g. "targetDate" for Contract Signing); copied to new items.
  naDates    String[]   @default([])
  subStages  SubStage[]

  @@unique([phase, name])
}

model SubStage {
  id          String           @id @default(cuid())
  phaseId     String
  phase       Phase            @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  templateId  String
  template    SubStageTemplate @relation(fields: [templateId], references: [id])
  name        String
  department  Department
  status      StageStatus      @default(NOT_STARTED)
  order       Int
  ownerId     String?
  owner       Person?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Plain dates (no time). Start/completed are recorded automatically when the status changes.
  targetDate  DateTime?        @db.Date
  startedAt   DateTime?        @db.Date
  completedAt DateTime?        @db.Date
  // Dates deliberately marked "N/A" ("targetDate" | "startedAt" | "completedAt"): not applicable to this item,
  // as opposed to simply not set yet. An N/A date stays empty and never raises a missing-date warning.
  naDates     String[]         @default([])
  // Free-text update typed by hand, and the calendar day it was last changed (set automatically).
  statusUpdate   String?
  statusUpdateAt DateTime?        @db.Date
  events      StatusEvent[]
  // Payment milestones triggered by this item (e.g. a Delivery item): see Milestone.
  milestones  Milestone[]
}

// A payment milestone of a project's contract (NTP/NTD, Milestone 1 (AP) ... Milestone 5): a share of the
// contract value that is invoiced and paid. The amount is percent x the project's contract value unless
// overridden. The stored status is NOT_DUE, INVOICE_SENT or PAYMENT_RECEIVED; "Overdue" is never stored,
// it is derived from the due date (see src/lib/payments.ts). An optional link to one of the project's own
// items (e.g. a Delivery item) makes the milestone active once that item is Done.
model Milestone {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order            Int
  label            String
  optional         Boolean   @default(false)
  percent          Decimal?  @db.Decimal(6, 3)
  amountOverride   Decimal?  @db.Decimal(14, 2)
  linkedSubStageId String?
  linkedSubStage   SubStage? @relation(fields: [linkedSubStageId], references: [id], onDelete: SetNull)
  dueDate          DateTime? @db.Date
  status           String    @default("NOT_DUE")
  invoiceSentDate  DateTime? @db.Date
  paidDate         DateTime? @db.Date
  // Links (SharePoint etc.) to the invoice and to the payslip / proof of payment; links only, no file storage.
  invoiceLink      String?
  payslipLink      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, order])
}

// An extra piece of work agreed after the contract, invoiced separately.
model ChangeOrder {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason        String
  status        String    @default("SENT") // SENT | OVERDUE | COMPLETE (COMPLETE automatically once the invoice is PAID)
  amount        Decimal?  @db.Decimal(14, 2)
  dateSent      DateTime? @db.Date
  invoicedDate  DateTime? @db.Date
  invoiceStatus String? // SENT | OVERDUE | PAID
  // Payment terms in days after the invoice date (Net+10 = 10). The due date is calculated from it, never stored.
  paymentTermsDays Int?
  fileLink      String?
  // Links to the invoice and to the payslip / proof of payment.
  invoiceLink   String?
  payslipLink   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, createdAt])
}

// A change proposed by an outside reader (e.g. a Dots agent reading Outlook), waiting for a person to approve it.
// Nothing is applied until it is approved on the Inbox page. `payload` holds the kind-specific fields (validated
// in src/lib/suggestions.ts); `projectId` is the matched project (null = the reviewer picks one).
model Suggestion {
  id               String    @id @default(cuid())
  kind             String // PHASE_UPDATE | ITEM_UPDATE | MILESTONE_UPDATE | CONTACT | NOTE
  payload          Json
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectRef       String? // what the sender called the project, as written
  summary          String // one line for the reviewer
  evidence         String? // the part of the email that supports it
  sourceFrom       String?
  sourceSubject    String?
  sourceReceivedAt DateTime?
  sourceLink       String? // link to the email (e.g. Outlook on the web)
  externalId       String?   @unique // the sender's own id for it, so a retry doesn't create a duplicate
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  resultNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
}

// Every status change, with its timestamp, so dates can always be reconstructed.
model StatusEvent {
  id         String       @id @default(cuid())
  subStageId String
  subStage   SubStage     @relation(fields: [subStageId], references: [id], onDelete: Cascade)
  fromStatus StageStatus?
  toStatus   StageStatus
  at         DateTime     @default(now())
  source     String

  @@index([subStageId, at])
}

model Person {
  id                 String            @id @default(cuid())
  name               String            @unique
  email              String?
  active             Boolean           @default(true)
  subStages          SubStage[]
  defaultFor         DepartmentOwner[]
  ownedPhases        Phase[]           @relation("PhaseOwner")
  defaultForPhases   PhaseDefaultOwner[]
  engineeredProfiles ProjectProfile[]
  createdAt          DateTime          @default(now())
}

// The person who owns new items of a department by default (used when projects are created).
model DepartmentOwner {
  department Department @id
  personId   String
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// The person who owns a phase by default on newly created projects (set on the People page).
model PhaseDefaultOwner {
  phase    PhaseName @id
  personId String
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model ImportReviewItem {
  id             String   @id @default(cuid())
  boardId        String
  mondayItemId   String
  itemName       String
  rawCustomerRef String
  reason         String
  createdAt      DateTime @default(now())

  @@unique([boardId, mondayItemId])
}
