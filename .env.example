DATABASE_URL=
MONDAY_API_TOKEN=

# Control Table board (5738893445) column ids — find with:
#   npm run monday:inspect-columns -- 5738893445
MONDAY_CONTROL_TABLE_PROJECT_LINK_COLUMN_ID=
MONDAY_CONTROL_TABLE_CONTRACT_VALUE_COLUMN_ID=
MONDAY_CONTROL_TABLE_CAPACITY_COLUMN_ID=
MONDAY_CONTROL_TABLE_COUNTRY_COLUMN_ID=

# Shared login password for the web app (min 10 characters)
APP_PASSWORD=

# Optional: the weekly updates email (Sundays 07:00 Israel time) through Microsoft Graph. All of these must be set.
#   An Entra app with the Mail.Send application permission, limited to the sender mailbox.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=
WEEKLY_UPDATES_TO=
# Vercel Cron sends this as "Authorization: Bearer ..." (16+ random characters); without it the cron route refuses everything.
CRON_SECRET=
# Inbox intake: the secret token the email-reading agent (e.g. a Dots agent) sends as "Authorization: Bearer ..." when it
# posts suggestions to /api/intake/suggestions (16+ random characters; without it the endpoint refuses everything).
INTAKE_TOKEN=
# Used for the link in the email (default https://solargik-tracker.vercel.app)
APP_BASE_URL=

# Optional: switches on "Read contract" on the project profile (Claude reads an uploaded contract PDF).
ANTHROPIC_API_KEY=
